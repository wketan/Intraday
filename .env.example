# Angel One Credentials
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_ID=your_client_id
ANGEL_PASSWORD=your_password
ANGEL_TOTP_SECRET=your_totp_secret

# Optional: AI Analysis (Claude)
ANTHROPIC_API_KEY=sk-ant-...
# Models: layers A/B/C use Sonnet, Layer D (in-flight, frequent) uses Haiku by default.
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_MODEL_INFLIGHT=claude-haiku-4-5-20251001
# ANTHROPIC_CACHE_ENABLED=true        # prompt caching for repeated layer prompts

# Optional: Slack Alerts
SLACK_WEBHOOK=https://hooks.slack.com/services/...

# Optional: Risk guards (kill-switch). Engine stops firing new alerts when hit.
# DAILY_LOSS_LIMIT=2000              # rupees (after brokerage + slippage)
# MAX_TRADES_PER_DAY=8

# Optional: Cost model (subtracted from displayed P&L)
# BROKERAGE_PER_LOT=100              # round-trip rupees per lot
# SLIPPAGE_BPS_PER_SIDE=50           # 50bp = 0.5% slippage per side

# Optional: Scan loop tuning
# SCAN_INTERVAL=30                   # seconds (was 5; raised because candles are 5-min)
# CANDLE_CACHE_TTL=90                # seconds — 5-min candles only update every 5 min
# AUTO_CLOSE_HOUR=15                 # auto-close all open positions at HH:MM IST
# AUTO_CLOSE_MINUTE=15               # 15:15 default (was 15:25 — last 15 min has 2-3x spreads)

# Optional: Option exit-level mode (step 14)
# OPT_EXIT_MODE=premium_pct          # "premium_pct" (default, real prices) | "delta_scaled" (legacy)
# OPT_SL_PCT=0.35                    # 35% premium loss = stop (when premium_pct)
# OPT_T1_PCT=0.50                    # 50% premium gain = T1
# OPT_T2_PCT=1.00                    # 100% premium gain = T2

# Optional: Strict greeks (step 15)
# STRICT_GREEKS=false                # true = reject signals when Angel doesn't return live delta
                                     # (no fallback ladder, no estimation — guaranteed real-delta only)

# ─── Engine scheduling ─────────────────────────────────────────────────
# INTRADAY_RESEARCH_MODE=0           # 1 = block the 08:45 auto-start (strategy rebuild pause).
                                     # Default 0: engine auto-starts every trading morning and
                                     # a catch-up starter retries every ~10 min during market
                                     # hours if the engine is found down.

# ─── Regime router (STRATEGY=auto, the default) ────────────────────────
# AUTO_ADX_PERIOD=10                 # ADX period on 5-min bars (14 is too slow intraday)
# AUTO_ADX_TREND=25                  # ADX >= this → trend regime → Conductor
# AUTO_ADX_RANGE=20                  # ADX <= this → range regime → Reverter
                                     # (between the two, VWAP-cross count decides)
# AUTO_DZ_START=12:00                # midday dead zone (U-shaped intraday vol trough):
# AUTO_DZ_END=13:45                  # always routes to mean-reversion during this window

# ─── Chain prefetch (feeds Conductor's flow dimension) ─────────────────
# CHAIN_PREFETCH_TTL=120             # seconds between proactive option-chain fetches

# ─── Premium ORB module (evidence-backed NIFTY option-buying) ──────────
# PREMIUM_ORB_ENABLED=true
# PREMIUM_ORB_INSTRUMENTS=NIFTY      # comma-separated
# PREMIUM_ORB_TARGET_PREM=200        # pick strike whose premium is nearest this (₹)
# PREMIUM_ORB_OR_END=11:15           # premium opening-range window ends here
# PREMIUM_ORB_LAST_ENTRY=14:30       # no entries after this
# PREMIUM_ORB_SL_PCT=0.20            # 20% premium SL (from the cost-inclusive backtest)
# PREMIUM_ORB_T1_PCT=0.50
# PREMIUM_ORB_T2_PCT=1.00
# PREMIUM_ORB_REGIME_GATE=true       # skip entries while ADX classifier reads 'range'

# ─── Time stop (theta defense on ALL option-buy positions) ─────────────
# TIME_STOP_MIN=30                   # exit if premium hasn't advanced within N min (0 = off)
# TIME_STOP_MIN_GAIN_PCT=15          # "advanced" = peaked at least this % over entry

# ─── Alerting / position caps ──────────────────────────────────────────
# MAX_OPEN_POSITIONS=2               # concurrent open paper positions (0 = uncapped)
# SWING_SLACK_ENABLED=true           # swing entry + AI-exit Slack pings

# ─── v2 strategy (Phase 2) ─────────────────────────────────────────────
# STRATEGY=auto                      # "auto" (default: ADX router conductor/reverter),
                                     # or pin one of: conductor, reverter, scalper_v3,
                                     # nifty_windows, deadzone_fade, patterns, v1, v2
# DRY_RUN_V2=false                   # when STRATEGY=v2 AND true → observe signals on Slack only
                                     # no real trades, no DB pollution, no kill-switch impact
# V2_MAX_VIX=22                      # block trades when India VIX above this
# V2_BLOCK_MONDAY=true               # weekend-gap-risk filter
# V2_NO_ENTRY_HOUR=12                # no new entries after this hour:min IST
# V2_NO_ENTRY_MINUTE=30
# V2_EXPIRY_BLOCK_HOUR=11            # on expiry day, no trades after this hour

# v2 confluence thresholds (tune if signals fire too rarely or too often):
# V2_TRIGGER_SCORE=3                 # require N of 4 conditions (3 default)
# V2_RSI_LONG=52                     # RSI must exceed this for LONG (was 55 in v2.0)
# V2_RSI_SHORT=48                    # RSI must be below this for SHORT (was 45)
# V2_VWAP_DEV_PCT=0.05               # require ≥0.05% deviation from VWAP (noise filter)
# V2_RANGE_MULT=1.2                  # current bar range > 1.2× 20-bar avg (replaces vol)
# V2_ATR_SL_MULT=1.2                 # SL distance = 1.2 × ATR
# V2_RR_TARGET=1.5                   # T1 = 1.5 × actual_risk
# V2_RR_TARGET2=2.5                  # T2 = 2.5 × actual_risk

# Server port (default 5050, Render sets this automatically)
PORT=5050
